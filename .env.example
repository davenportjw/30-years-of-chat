# Google Cloud Platform & Gemini Configuration
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Cloud Run Deployed Service & Base URL
# Once deployed, set this to your Cloud Run service URL
SERVICE_URL=https://agents-of-chat-YOUR_PROJECT_NUMBER.us-central1.run.app
BASE_URL=http://localhost:8080

# Local Server Settings
PORT=8080
STATIC_DIR=frontend/build/web
